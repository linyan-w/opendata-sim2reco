\contentsline {figure}{\numberline {1}{\ignorespaces Architecture of the surrogate. Solid arrows are data flow, dashed arrows conditioning on quantities sampled by an earlier head, the dotted arrow cross-attention to the particle token states.}}{9}{figure.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Why the event-by-event matrix is asymmetric. Left: MasterAnaDev versus one surrogate draw, row-normalised. Centre: two independent surrogate draws for the same events, row-normalised, showing the same asymmetry. Right: the joint (unnormalised) MasterAnaDev-versus-surrogate matrix, symmetric to 0.0002{}.}}{10}{figure.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces Prong-multiplicity confusion, row-normalised. Left and centre: reconstructed prongs versus true charged hadrons (p, $\pi ^\pm $, $K^\pm $ after FSI) for MasterAnaDev and for the surrogate. Right: MasterAnaDev's count versus one surrogate draw for the same event.}}{11}{figure.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Left: reconstructed hadron-prong multiplicity, MasterAnaDev versus one surrogate sample per event. Right: observed and predicted probability of a reconstructed muon candidate versus the number of true hadrons after the input cuts.}}{12}{figure.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Muon response in model space: $\log (P_\mathrm {reco}/P_\mathrm {true})$ for MINOS-matched (left) and unmatched (centre) muons, and the difference of the projected angle $\theta _x$ (right).}}{13}{figure.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces Reconstructed-minus-true vertex residuals in model space (asinh-compressed).}}{14}{figure.6}%
\contentsline {figure}{\numberline {7}{\ignorespaces Calorimetric branches, $\log (E+1)$. The first three are generated; the spike at zero is the exactly-zero population. The last two are derived from \texttt {recoil\_E} at decode time.}}{14}{figure.7}%
\contentsline {figure}{\numberline {8}{\ignorespaces Conditional response: median and 16--84\% band of the muon momentum ratio versus true muon momentum (left) and of $\log E_\mathrm {recoil}$ versus true hadronic kinetic energy after cuts (right).}}{14}{figure.8}%
\contentsline {figure}{\numberline {9}{\ignorespaces Correlation matrices of the nine event-level variables (order as in Table~\ref {tab:tier1}).}}{15}{figure.9}%
\contentsline {figure}{\numberline {10}{\ignorespaces Particle identification versus true species on single-hadron, single-prong events. Left and centre: row-normalised outcome matrices for MasterAnaDev and the surrogate. Right: ROC curves of the proton score for true protons against true charged pions.}}{17}{figure.10}%
\contentsline {figure}{\numberline {11}{\ignorespaces Hadron validation against the truth. Left: fraction of events with at least one proton fit versus the true leading-proton kinetic energy. Centre: proton-hypothesis momentum of the leading prong versus the same, median and 16--84\% band. Right: mean number of reconstructed prongs (all, and with kinematics) versus the true number of charged hadrons after FSI.}}{17}{figure.11}%
\contentsline {figure}{\numberline {12}{\ignorespaces Left: proton score of prongs with a proton fit, for events whose leading true hadron is a proton or a charged pion. Centre: pion-hypothesis momentum. Right: prong angle to the beam.}}{17}{figure.12}%
\contentsline {figure}{\numberline {13}{\ignorespaces Prong direction, pion- and proton-hypothesis momenta, and proton score.}}{18}{figure.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces Per-event number of prongs with kinematics, with a proton fit, and exiting the detector.}}{18}{figure.14}%
\contentsline {figure}{\numberline {15}{\ignorespaces Left: reconstructed vertex $z$ minus the nearest plane position; the spike at zero is the snapped population. Right: vertex class marginals (0 unsnapped, 4 nearest plane, 8 farther plane).}}{19}{figure.15}%
\contentsline {figure}{\numberline {16}{\ignorespaces Input coverage of the held-out mode. Left: final-state category after the input cuts for 2p2h and for all other modes. Right: leading-proton kinetic energy in two-proton, pion-less final states by interaction mode.}}{22}{figure.16}%
\contentsline {figure}{\numberline {17}{\ignorespaces 2p2h test events: muon momentum response versus true momentum, recoil energy versus true hadronic kinetic energy, and leading proton-hypothesis momentum versus true leading-proton kinetic energy, for the open dataset, model A and the blind model B (median and 16--84\% band).}}{23}{figure.17}%
\contentsline {figure}{\numberline {18}{\ignorespaces 2p2h test events: reconstruction probability versus true hadron count, mean reconstructed prongs versus true charged hadrons, and proton-fit rate versus true leading-proton kinetic energy.}}{24}{figure.18}%
\contentsline {figure}{\numberline {19}{\ignorespaces 2p2h test events: reconstructed prong multiplicity versus true charged hadrons for the open dataset, model A and the blind model B.}}{24}{figure.19}%
\contentsline {figure}{\numberline {20}{\ignorespaces Marginal pulls with the epistemic term only (dotted) and with the model-error floor derived on the training-split control added in quadrature (solid), for the test-split control and held-out 2p2h, model A (left) and model B (right). Upper row: the non-calorimetry set (recoil, muon momentum ratio and angle, prong count); lower row: the two non-vertex calorimetric quantities that carry the hard-edge residual. Unit normal for reference.}}{31}{figure.20}%
\contentsline {figure}{\numberline {21}{\ignorespaces Per-event epistemic variances of the 2p2h-blind model B on held-out 2p2h events and on in-distribution control events. Left: variance of the logit of the reconstruction probability (how unsure the model is that the event gets a muon candidate). Centre: variance of the prong-count logits, averaged over the nine classes. Right: variance of the generated event-level vector (muon, vertex, calorimetry) under re-drawn output weights, summed over its nine components. A model that found 2p2h unfamiliar would put the orange histograms to the right of the green ones.}}{32}{figure.21}%
\contentsline {figure}{\numberline {22}{\ignorespaces Positive control, i.e.\ does the flag fire when it should: the same three variances for the nominal control events and for the same events perturbed out of the training support (hadron momenta $\times 4$, hadron tokens $\times 3$, vertex moved to $z = 2500$\,mm, outside the training range, and all three). Only the context shift separates.}}{33}{figure.22}%
\contentsline {figure}{\numberline {23}{\ignorespaces Pull summary for the conditional means: all seven observables binned against truth variables, all populated bins, model A (left) and model B (right), on control and on held-out 2p2h events, with a unit normal scaled to the control count for reference. The individual observables are in Figs.~\ref {fig:bb-eff}--\ref {fig:bb-dthx}.}}{33}{figure.23}%
\contentsline {figure}{\numberline {24}{\ignorespaces Pull summary for the marginal histograms: the six observables binned in themselves, all populated bins, same layout as Fig.~\ref {fig:bayes-cal}; pulls beyond $\pm 6$ are placed in the end bins. The individual observables are in Figs.~\ref {fig:bm-nprong}--\ref {fig:bm-dthx}.}}{34}{figure.24}%
